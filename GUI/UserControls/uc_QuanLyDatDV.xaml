<UserControl x:Class="GUI.UserControls.uc_QuanLyDatDV"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             TextElement.FontFamily="Roboto"
             Loaded="UserControl_Loaded"
             d:DesignHeight="641" d:DesignWidth="1300">
    
    <UserControl.Resources>
        <Style x:Key="GreenRoundedButton" TargetType="Button">
            <Setter Property="Background" Value="#FF478C10"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    
    <Grid Background="#FFFFFF">
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Width="1300">
            <materialDesign:ColorZone Mode="Standard" CornerRadius="5" HorizontalAlignment="Right" Margin="0,0,50,0"
                                      VerticalAlignment="Center"
                                      Width="250">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{DynamicResource MaterialDesignToolButton}">
                        <materialDesign:PackIcon Kind="Search" Opacity=".56" />
                    </Button>
                    <TextBox Grid.Column="1" Name="txtFilter" TextChanged="txtFilter_TextChanged"
                             Margin="0 0 10 0"
                             materialDesign:HintAssist.Hint="Tìm khách hàng / dịch vụ"
                             materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                             BorderThickness="0"
                             MinWidth="200"
                             FlowDirection="LeftToRight"
                             VerticalAlignment="Center" />
                </Grid>
            </materialDesign:ColorZone>
        </Grid>

        <Grid Grid.Row="1">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="1200" Height="520" Background="#F2F1F1">
                <Grid.Clip>
                    <RectangleGeometry Rect="0,0,1200,520" RadiusX="10" RadiusY="10" />
                </Grid.Clip>
                <ListView ScrollViewer.HorizontalScrollBarVisibility="Disabled" Name="lsvCTSDDV">
                    <ListView.View>
                        <GridView>
                            <GridView.ColumnHeaderContainerStyle>
                                <Style TargetType="{x:Type GridViewColumnHeader}">
                                    <Setter Property="Background" Value="LightBlue" />
                                    <Setter Property="Foreground" Value="Black" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                </Style>
                            </GridView.ColumnHeaderContainerStyle>

                            <GridViewColumn Width="60" Header="Mã" DisplayMemberBinding="{Binding MaCTSDDV}" />
                            <GridViewColumn Width="160" Header="Khách hàng" DisplayMemberBinding="{Binding TenKH}" />
                            <GridViewColumn Width="160" Header="Dịch vụ" DisplayMemberBinding="{Binding TenDV}" />
                            <GridViewColumn Width="90" Header="Mã phòng" DisplayMemberBinding="{Binding SoPhong}" />
                            <GridViewColumn Width="70" Header="Số lượng" DisplayMemberBinding="{Binding SL}" />
                            <GridViewColumn Width="100" Header="Thành tiền"
                                            DisplayMemberBinding="{Binding ThanhTien, StringFormat={}{0:N0} VND}" />
                            <GridViewColumn Width="120" Header="Ngày áp dụng"
                                            DisplayMemberBinding="{Binding NgayApDung, StringFormat=dd/MM/yyyy HH:mm}" />
                            <GridViewColumn Width="100" Header="Thanh toán">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsThreeState="False"
                                                  IsEnabled="True"
                                                  IsHitTestVisible="False"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding DaThanhToan, TargetNullValue=False}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="100" Header="Hình thức"
                                            DisplayMemberBinding="{Binding HinhThucThanhToan}" />
                            <GridViewColumn Width="120" Header="Trạng thái" DisplayMemberBinding="{Binding TrangThai}" />

                            <GridViewColumn Width="120" Header="Chức năng">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Width="90" Height="28" Click="click_ChucNang">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource GreenRoundedButton}">
                                                    <Setter Property="Content" Value="In phiếu"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding HasMaCTPT}" Value="False" />
                                                                <Condition Binding="{Binding TrangThai}" Value="Dịch vụ đã đặt" />
                                                                <Condition Binding="{Binding DaThanhToan}" Value="False" />
                                                                <Condition Binding="{Binding HinhThucThanhToan}" Value="Direct" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Content" Value="Thanh toán"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
