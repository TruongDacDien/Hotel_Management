<UserControl x:Class="GUI.UserControls.uc_QuanLyDatDV"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             TextElement.FontFamily="Roboto"
             Loaded="UserControl_Loaded"
             d:DesignHeight="641" d:DesignWidth="1300">
    <Grid Background="#FFFFFF">
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Width="1300">
            <materialDesign:ColorZone Mode="Standard" CornerRadius="5" HorizontalAlignment="Right" Margin="0,0,50,0"
                                      VerticalAlignment="Center"
                                      Width="250">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{DynamicResource MaterialDesignToolButton}">
                        <materialDesign:PackIcon Kind="Search" Opacity=".56" />
                    </Button>
                    <TextBox Grid.Column="1" Name="txtFilter" TextChanged="txtFilter_TextChanged"
                             Margin="0 0 10 0"
                             materialDesign:HintAssist.Hint="Tim khach hang / dich vu"
                             materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                             BorderThickness="0"
                             MinWidth="200"
                             FlowDirection="LeftToRight"
                             VerticalAlignment="Center" />
                </Grid>
            </materialDesign:ColorZone>
        </Grid>

        <Grid Grid.Row="1">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="1150" Height="520" Background="#F2F1F1">
                <Grid.Clip>
                    <RectangleGeometry Rect="0,0,1150,520" RadiusX="10" RadiusY="10" />
                </Grid.Clip>
                <ListView ScrollViewer.HorizontalScrollBarVisibility="Disabled" Name="lsvCTSDDV">
                    <ListView.View>
                        <GridView>
                            <GridView.ColumnHeaderContainerStyle>
                                <Style TargetType="{x:Type GridViewColumnHeader}">
                                    <Setter Property="Background" Value="LightBlue" />
                                    <Setter Property="Foreground" Value="Black" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                </Style>
                            </GridView.ColumnHeaderContainerStyle>

                            <GridViewColumn Width="90" Header="Mã" DisplayMemberBinding="{Binding MaCTSDDV}" />
                            <GridViewColumn Width="160" Header="Khách hàng" DisplayMemberBinding="{Binding TenKH}" />
                            <GridViewColumn Width="160" Header="Dịch vụ" DisplayMemberBinding="{Binding TenDV}" />
                            <GridViewColumn Width="90" Header="Phòng" DisplayMemberBinding="{Binding SoPhong}" />
                            <GridViewColumn Width="70" Header="Số lượng" DisplayMemberBinding="{Binding SL}" />
                            <GridViewColumn Width="140" Header="Thành tiền"
                                            DisplayMemberBinding="{Binding ThanhTien, StringFormat={}{0:N0} VND}" />
                            <GridViewColumn Width="150" Header="Ngày áp dụng"
                                            DisplayMemberBinding="{Binding NgayApDung, StringFormat=dd/MM/yyyy HH:mm}" />
                            <GridViewColumn Width="130" Header="Trạng thái" DisplayMemberBinding="{Binding TrangThai}" />

                            <GridViewColumn Width="110" Header="S&#x1eed; d&#x1ee5;ng">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="S&#x1eed; d&#x1ee5;ng" Width="90" Height="28" Click="click_SuDung">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DaThanhToan}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Width="110" Header="In phi&#x1ebf;u">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="In phi&#x1ebf;u" Width="90" Height="28" Click="click_InPhieu">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DaThanhToan}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
